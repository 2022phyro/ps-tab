# Kwuo Environment Configuration Template
# Copy this file to .env and replace the values with your local or production secrets.

APP_NAME=Kwuo
ENVIRONMENT=development
DEBUG=true

# Cryptographic signing secret for JWTs and session authentication (minimum 32 characters)
# Generate a secure key with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-secure-32-byte-secret-key-here-replace-for-security

# PostgreSQL Database connection URL (asyncpg driver)
DATABASE_URL=postgresql+asyncpg://db_user:db_password@localhost:5432/kwuo_db

# Redis connection URL (caching and ARQ task queues)
REDIS_URL=redis://localhost:6379/0

# Server Binding
HOST=0.0.0.0
PORT=8000
