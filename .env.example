# Copy to .env (local) and fill in real values. Never commit the real .env file.

# --- Database (Prisma) ---
# Local dev: local WSL Postgres (see PLAN.md "Local Postgres setup").
# Production: swap for a cloud-reachable Postgres (e.g. Neon) before deploying to Vercel.
DATABASE_URL="postgresql://user:password@localhost:5432/ps_tab?schema=public"

# --- Redis (rate limiting) ---
# Local dev: local Redis instance.
# Production: swap for a cloud-hosted Redis before deploying to Vercel.
REDIS_URL="redis://localhost:6379"

# --- Auth.js ---
AUTH_SECRET=""

# --- Resend (transactional email) ---
RESEND_API_KEY=""
EMAIL_FROM="PS Tab <no-reply@example.com>"

# --- Inngest (background jobs) ---
INNGEST_EVENT_KEY=""
INNGEST_SIGNING_KEY=""

# --- Sentry (error tracking) ---
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
# Only needed for source map upload during `next build` (optional, build-time only)
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""

# --- App ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"
